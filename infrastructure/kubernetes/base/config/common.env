# Non-secret settings shared by every service (ConfigMap "emb-common").
# Connection strings with credentials (DATABASE_URL, RABBITMQ_URL, REDIS_URL) and
# INTERNAL_API_TOKEN are NOT here: they come from Secrets via secretKeyRef.
NODE_ENV=production
LOG_LEVEL=info
JWKS_URL=http://auth-service:3001/.well-known/jwks.json
# OpenTelemetry: point at an OpenTelemetry Collector (or Jaeger/Loki OTLP endpoints).
# The hostname below is a placeholder; overlays override it or disable the SDK.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector.observability.svc:4318/v1/traces
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://otel-collector.observability.svc:4318/v1/logs
OTEL_LOGS_EXPORTER=otlp
OTEL_SDK_DISABLED=false
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
