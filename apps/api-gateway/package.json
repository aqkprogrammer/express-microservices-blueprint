{
  "name": "@emb/api-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Edge API gateway: routing, request/correlation IDs, rate limiting, body limits, security headers, upstream timeouts and circuit breakers. No business logic.",
  "scripts": {
    "build": "tsc -b",
    "start": "node --import ./dist/telemetry.js dist/main.js",
    "dev": "tsx watch --conditions=source --import ./src/telemetry.ts src/main.ts"
  },
  "dependencies": {
    "@emb/config": "^0.1.0",
    "@emb/contracts": "^0.1.0",
    "@emb/http-kit": "^0.1.0",
    "@emb/logger": "^0.1.0",
    "@emb/observability": "^0.1.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "ioredis": "^6.0.0",
    "rate-limit-redis": "^6.0.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  }
}
