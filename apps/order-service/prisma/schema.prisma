// Order service — owns orders and the order-processing saga state.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Status: PENDING | AWAITING_PAYMENT | CONFIRMED | CANCELLED | REQUIRES_REVIEW
model Order {
  id                 String   @id @db.Uuid
  customerId         String   @map("customer_id") @db.Uuid
  status             String
  currency           String   @db.Char(3)
  totalCents         Int      @map("total_cents")
  /// Simulated payment-method token (never a card number)
  paymentMethodToken String   @map("payment_method_token")
  idempotencyKey     String   @map("idempotency_key")
  /// SHA-256 of the canonical request body, to detect key reuse with a different payload
  requestHash        String   @map("request_hash")
  cancellationReason String?  @map("cancellation_reason")
  reviewReason       String?  @map("review_reason")
  paymentId          String?  @map("payment_id") @db.Uuid
  reservationId      String?  @map("reservation_id") @db.Uuid
  version            Int      @default(1)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  lines   OrderLine[]
  history OrderStatusHistory[]
  saga    OrderSaga?

  @@unique([customerId, idempotencyKey])
  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

/// Price snapshot taken at order time; later catalog price changes do not affect the order.
model OrderLine {
  orderId        String @map("order_id") @db.Uuid
  productId      String @map("product_id") @db.Uuid
  sku            String
  name           String
  quantity       Int
  unitPriceCents Int    @map("unit_price_cents")
  lineTotalCents Int    @map("line_total_cents")
  order          Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@id([orderId, productId])
  @@map("order_lines")
}

model OrderStatusHistory {
  id          BigInt   @id @default(autoincrement())
  orderId     String   @map("order_id") @db.Uuid
  fromStatus  String?  @map("from_status")
  toStatus    String   @map("to_status")
  reason      String?
  /// customer | system | admin
  actor       String
  /// ID of the request or message that caused the transition
  causationId String?  @map("causation_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

/// Persistent saga state so the orchestrator survives restarts.
/// Step: AWAITING_INVENTORY | AWAITING_PAYMENT | COMPLETED | COMPENSATED | REQUIRES_REVIEW
model OrderSaga {
  orderId         String    @id @map("order_id") @db.Uuid
  step            String
  deadlineAt      DateTime? @map("deadline_at") @db.Timestamptz(3)
  paymentAttempts Int       @default(0) @map("payment_attempts")
  timeoutChecks   Int       @default(0) @map("timeout_checks")
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([step, deadlineAt])
  @@map("order_sagas")
}

// ── Messaging infrastructure tables (identical in every service schema) ───────
// Transactional outbox: written in the same transaction as the business change,
// published by the in-process OutboxRelay (packages/messaging).
model OutboxEvent {
  id            String    @id @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  exchange      String
  routingKey    String    @map("routing_key")
  envelope      Json
  headers       Json      @default("{}")
  /// PENDING | PUBLISHING | PUBLISHED (CHECK constraint in migration)
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz(3)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)

  @@index([status, availableAt])
  @@index([publishedAt])
  @@map("outbox_events")
}

// Idempotent-consumer markers: (consumer, message id) inserted in the handler's transaction.
model ProcessedMessage {
  consumer    String
  messageId   String   @map("message_id")
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([consumer, messageId])
  @@index([processedAt])
  @@map("processed_messages")
}
