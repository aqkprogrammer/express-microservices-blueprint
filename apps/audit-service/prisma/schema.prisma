// Audit service — append-only record of significant business and security events.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// The primary key is the event ID, so redelivered events are recorded once.
/// `details` only contains allow-listed fields (no emails, names, tokens or secrets).
model AuditRecord {
  eventId       String   @id @map("event_id") @db.Uuid
  eventType     String   @map("event_type")
  category      String
  producer      String
  subjectId     String?  @map("subject_id")
  actorId       String?  @map("actor_id")
  correlationId String   @map("correlation_id")
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(3)
  recordedAt    DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  details       Json

  @@index([eventType, occurredAt])
  @@index([subjectId, occurredAt])
  @@index([correlationId])
  @@index([occurredAt])
  @@map("audit_records")
}

// ── Messaging infrastructure tables (identical in every service schema) ───────
// Transactional outbox: written in the same transaction as the business change,
// published by the in-process OutboxRelay (packages/messaging).
model OutboxEvent {
  id            String    @id @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  exchange      String
  routingKey    String    @map("routing_key")
  envelope      Json
  headers       Json      @default("{}")
  /// PENDING | PUBLISHING | PUBLISHED (CHECK constraint in migration)
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz(3)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)

  @@index([status, availableAt])
  @@index([publishedAt])
  @@map("outbox_events")
}

// Idempotent-consumer markers: (consumer, message id) inserted in the handler's transaction.
model ProcessedMessage {
  consumer    String
  messageId   String   @map("message_id")
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([consumer, messageId])
  @@index([processedAt])
  @@map("processed_messages")
}
