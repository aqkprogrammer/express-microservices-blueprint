    "/api/v1/notifications/templates/{key}": {
      "put": {
        "tags": [
          "Notifications (admin)"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Edit a template (versioned, optimistic concurrency)",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "required": true,
            "name": "key",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTemplateRequest"
              }
            }
          }
        },
        "responses": {
