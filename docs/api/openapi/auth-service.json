                          "message": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "path",
                          "message"
                        ]
                      }
                    }
                  },
                  "required": [
                    "type",
                    "title",
                    "status"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Conflict with current state",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
