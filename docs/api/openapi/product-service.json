{
  "openapi": "3.1.0",
  "info": {
    "title": "Product Service API",
    "version": "1.0.0",
    "description": "Catalog listing, search, details and admin management. Internal `/internal/*` routes are not exposed.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local API gateway"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message"
              ]
            }
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ]
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "price": {
            "type": "object",
            "properties": {
              "amountCents": {
                "type": "integer"
              },
              "currency": {
                "type": "string"
              }
            },
            "required": [
              "amountCents",
              "currency"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "discontinued"
            ]
          },
          "availability": {
            "type": "object",
            "properties": {
              "availableQuantity": {
                "type": "integer"
              },
              "inStock": {
                "type": "boolean"
              },
              "updatedAt": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "availableQuantity",
              "inStock",
              "updatedAt"
            ]
          },
          "version": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "sku",
          "name",
          "description",
          "category",
          "price",
          "status",
          "availability",
          "version",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateProductRequest": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9-]{2,39}$"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 5000,
            "default": ""
          },
          "category": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "priceCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "default": "USD"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "discontinued"
            ],
            "default": "draft"
          }
        },
        "required": [
          "sku",
          "name",
          "category",
          "priceCents"
        ]
      },
      "UpdateProductRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "category": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "priceCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "discontinued"
            ]
          },
          "expectedVersion": {
            "type": "integer",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/products": {
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "List and search the catalog (public). Cached in Redis.",
        "description": "Anonymous callers only see active products. Admins may filter by status. Results are cache-aside cached for ~60s and invalidated on catalog changes.",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 1
            },
            "required": false,
            "name": "page",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "required": false,
            "name": "pageSize",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "required": false,
            "name": "q",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 60
            },
            "required": false,
            "name": "category",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "draft",
                "active",
                "discontinued"
              ]
            },
            "required": false,
            "name": "status",
            "in": "query"
          },
          {
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "required": false,
            "name": "minPriceCents",
            "in": "query"
          },
          {
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "required": false,
            "name": "maxPriceCents",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "required": false,
            "name": "inStock",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "newest",
                "price",
                "-price",
                "name",
                "-name"
              ],
              "default": "newest"
            },
            "required": false,
            "name": "sort",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of products",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Product"
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "properties": {
                        "page": {
                          "type": "integer"
                        },
                        "pageSize": {
                          "type": "integer"
                        },
                        "totalItems": {
                          "type": "integer"
                        },
                        "totalPages": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "page",
                        "pageSize",
                        "totalItems",
                        "totalPages"
                      ]
                    }
                  },
                  "required": [
                    "data",
                    "pagination"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
