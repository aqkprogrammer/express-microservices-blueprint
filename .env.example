# Copy to `.env` to override the synthetic local-development defaults baked
# into docker-compose.yml. Never commit `.env`. Never reuse these values
# outside your workstation — generate real secrets for any shared environment
# (e.g. `openssl rand -base64 32`) and inject them from a secret manager.

# ── Shared service-to-service token (min. 32 characters) ──────────────────────
INTERNAL_API_TOKEN=local-dev-internal-token-change-me-000000

# ── PostgreSQL (one role + database per service) ─────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-dev-postgres-password
AUTH_DB_PASSWORD=local-dev-auth-db-password
USER_DB_PASSWORD=local-dev-user-db-password
PRODUCT_DB_PASSWORD=local-dev-product-db-password
INVENTORY_DB_PASSWORD=local-dev-inventory-db-password
ORDER_DB_PASSWORD=local-dev-order-db-password
PAYMENT_DB_PASSWORD=local-dev-payment-db-password
NOTIFICATION_DB_PASSWORD=local-dev-notification-db-password
AUDIT_DB_PASSWORD=local-dev-audit-db-password
WORKER_DB_PASSWORD=local-dev-worker-db-password

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_USER=emb
RABBITMQ_PASSWORD=local-dev-rabbitmq-password

# ── Auth bootstrap (creates an admin account on first start) ─────────────────
ADMIN_EMAIL=admin@example.test
ADMIN_BOOTSTRAP_PASSWORD=local-dev-admin-password
# false only because the local stack is plain HTTP; always true behind TLS.
COOKIE_SECURE=false

# ── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-dev-grafana-password

# ── Behaviour knobs ──────────────────────────────────────────────────────────
LOG_LEVEL=info
RUN_SEED=true
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
CORS_ALLOWED_ORIGINS=http://localhost:5173
RESERVATION_TTL_MS=900000
SAGA_INVENTORY_TIMEOUT_MS=60000
SAGA_PAYMENT_TIMEOUT_MS=15000
SIMULATOR_LATENCY_MS=50
SIMULATOR_TIMEOUT_RESOLVES_AFTER_MS=20000
RECONCILE_AFTER_MS=20000
# Deliveries to this recipient domain fail on purpose (retry/DLQ demo). Empty disables.
SIMULATE_FAILURE_DOMAIN=bounce.test
OTEL_SDK_DISABLED=false
OTEL_TRACES_SAMPLER_ARG=1.0

# ── Image builds behind a TLS-intercepting proxy (optional) ───────────────────
# Path to a PEM bundle that npm should trust during `docker compose build`.
# EXTRA_CA_FILE=/path/to/corporate-ca.pem
